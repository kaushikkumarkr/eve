DATABASE_URL=sqlite:///./agency.db
# Production/local Postgres example:
# DATABASE_URL=postgresql+psycopg://agency:agency@localhost:55432/agency
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional Azure OpenAI research provider. The endpoint may include a path;
# the application normalizes it to the Azure resource root automatically.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
RESEARCH_MODE=heuristic
ADS_MODE=mock
OPENAI_ADS_API_KEY=
OPENAI_ADS_BASE_URL=https://api.ads.openai.com/v1
AGENCY_MUTATIONS_ENABLED=false
# Local role: admin may approve/apply; operator may research and draft.
AGENCY_ROLE=admin
# Generate with: uv run agency secrets-keygen
AGENCY_MASTER_KEY=
# Keep stdio for local Codex/Claude Code. Use streamable-http only behind
# Cloudflare Access or another private authenticated tunnel.
AGENCY_MCP_TRANSPORT=stdio
AGENCY_MCP_HOST=127.0.0.1
AGENCY_MCP_PORT=8000
AGENCY_MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp
AGENCY_ADMIN_TOKEN=
AGENCY_OPERATOR_TOKEN=
