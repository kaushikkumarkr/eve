# Local development only. Never commit a populated .env file.
DATABASE_URL=sqlite:///./agency.db

# Local Postgres example (required for shared work):
# DATABASE_URL=postgresql+psycopg://agency:<password>@127.0.0.1:55432/agency
AGENCY_POSTGRES_PASSWORD=
AGENCY_POSTGRES_USER=agency
AGENCY_POSTGRES_DB=agency
AGENCY_POSTGRES_BIND_ADDRESS=127.0.0.1
AGENCY_POSTGRES_PORT=55432

# Mock is the safe default. A normal Azure/OpenAI model key is never an Ads key.
ADS_MODE=mock
OPENAI_ADS_BASE_URL=https://api.ads.openai.com/v1
AGENCY_MUTATIONS_ENABLED=false

# Local secret backend. Generate only for development with: uv run agency secrets-keygen
EVE_SECRET_BACKEND=local_encrypted
AGENCY_MASTER_KEY=

# Azure shared deployment: install --extra azure, use a managed identity, and do
# not configure AGENCY_MASTER_KEY as the shared secret authority.
AZURE_KEY_VAULT_URL=

# Local MCP uses stdio. Remote Streamable HTTP must sit behind private identity
# infrastructure and never be exposed directly to the public internet.
AGENCY_MCP_TRANSPORT=stdio
AGENCY_MCP_AUTH_MODE=static
AGENCY_MCP_HOST=127.0.0.1
AGENCY_MCP_PORT=8000
AGENCY_MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp
# Enable both for stateless remote MCP gateways; leave false for local stdio.
AGENCY_MCP_JSON_RESPONSE=false
AGENCY_MCP_STATELESS_HTTP=false
# Shared admin workstation only; never put a client key in CLI arguments.
AGENCY_SECRET_INTAKE_URL=https://<private-host>/admin/client-secrets
AGENCY_SECRET_INTAKE_SCOPE=api://<eve-api-app-id>/.default
# Required when AGENCY_MCP_AUTH_MODE=entra (shared team deployment)
AZURE_TENANT_ID=
AGENCY_MCP_AUDIENCE=

# Optional Auth0 MCP identity provider. Eve's API and database remain in Azure.
# Use the API identifier and role claim documented in docs/CHATGPT_OAUTH.md.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ROLE_CLAIM=https://eve.internal/roles

# Local role/identity for CLI and stdio rehearsal. Shared deployments use each
# authenticated operator identity and explicit client access grants.
AGENCY_ROLE=admin
AGENCY_OPERATOR_ID=local-admin
EVE_PROCESS_ROLE=control
# Temporary isolated staging bootstrap only; generate distinct values with:
# openssl rand -hex 32
AGENCY_ADMIN_TOKEN=
AGENCY_OPERATOR_TOKEN=
