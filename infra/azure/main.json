{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "12872789964946957456"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for this isolated Eve environment."
      }
    },
    "registryName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique lowercase ACR name, 5-50 alphanumeric characters."
      }
    },
    "runtimeVaultName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique Key Vault name for runtime configuration."
      }
    },
    "clientVaultName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique Key Vault name for client Ads/CAPI credentials."
      }
    },
    "logAnalyticsName": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace name."
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Container Apps managed environment name."
      }
    },
    "virtualNetworkName": {
      "type": "string",
      "metadata": {
        "description": "VNet name. Use a new VNet for a private staging/production environment."
      }
    },
    "virtualNetworkAddressPrefix": {
      "type": "string",
      "defaultValue": "10.42.0.0/16",
      "metadata": {
        "description": "VNet address range; must not overlap connected operator/VPN networks."
      }
    },
    "containerAppsSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.42.0.0/23",
      "metadata": {
        "description": "Dedicated Container Apps infrastructure subnet. Size it before first deployment; it cannot be resized in place."
      }
    },
    "privateEndpointsSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.42.2.0/24",
      "metadata": {
        "description": "Dedicated subnet for private endpoints."
      }
    },
    "postgresSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.42.3.0/24",
      "metadata": {
        "description": "Dedicated subnet delegated only to Azure Database for PostgreSQL Flexible Server."
      }
    },
    "postgresServerName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique lowercase PostgreSQL Flexible Server name."
      }
    },
    "postgresAdministratorLogin": {
      "type": "string",
      "defaultValue": "eveprovisioner",
      "metadata": {
        "description": "PostgreSQL administrator login. Do not use this account for Eve runtime connections."
      }
    },
    "postgresAdministratorPassword": {
      "type": "securestring",
      "metadata": {
        "description": "PostgreSQL bootstrap administrator password. Pass securely; never store in source or deployment parameter files."
      }
    },
    "postgresSkuName": {
      "type": "string",
      "defaultValue": "Standard_B1ms",
      "metadata": {
        "description": "Azure PostgreSQL Flexible Server SKU. Confirm regional availability and cost before deployment."
      }
    },
    "postgresPrivateDnsZoneName": {
      "type": "string",
      "defaultValue": "eve-internal.postgres.database.azure.com",
      "metadata": {
        "description": "Private DNS zone for PostgreSQL. Must end in .postgres.database.azure.com and must not equal the server name."
      }
    },
    "postgresDatabaseName": {
      "type": "string",
      "defaultValue": "eve",
      "metadata": {
        "description": "PostgreSQL database Eve creates in the server."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Common tags. Include environment=staging or environment=production."
      }
    }
  },
  "variables": {
    "keyVaultSecretsUserRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "keyVaultPrivateDnsZoneName": "privatelink.vaultcore.azure.net"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "[parameters('virtualNetworkName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('virtualNetworkAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "container-apps-infrastructure",
            "properties": {
              "addressPrefix": "[parameters('containerAppsSubnetPrefix')]",
              "delegations": [
                {
                  "name": "container-apps",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          },
          {
            "name": "private-endpoints",
            "properties": {
              "addressPrefix": "[parameters('privateEndpointsSubnetPrefix')]",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          },
          {
            "name": "postgresql-flexible-server",
            "properties": {
              "addressPrefix": "[parameters('postgresSubnetPrefix')]",
              "delegations": [
                {
                  "name": "postgresql-flexible-server",
                  "properties": {
                    "serviceName": "Microsoft.DBforPostgreSQL/flexibleServers"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[variables('keyVaultPrivateDnsZoneName')]",
      "location": "global",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', variables('keyVaultPrivateDnsZoneName'), format('{0}-link', parameters('virtualNetworkName')))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('keyVaultPrivateDnsZoneName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[parameters('postgresPrivateDnsZoneName')]",
      "location": "global",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', parameters('postgresPrivateDnsZoneName'), format('{0}-link', parameters('virtualNetworkName')))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', parameters('postgresPrivateDnsZoneName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[parameters('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[parameters('registryName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('runtimeVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enablePurgeProtection": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "bypass": "None",
          "defaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('clientVaultName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enablePurgeProtection": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "publicNetworkAccess": "Disabled",
        "networkAcls": {
          "bypass": "None",
          "defaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2024-08-01",
      "name": "[parameters('postgresServerName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('postgresSkuName')]",
        "tier": "Burstable"
      },
      "properties": {
        "administratorLogin": "[parameters('postgresAdministratorLogin')]",
        "administratorLoginPassword": "[parameters('postgresAdministratorPassword')]",
        "version": "16",
        "highAvailability": {
          "mode": "Disabled"
        },
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Disabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "network": {
          "delegatedSubnetResourceId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), 'postgresql-flexible-server')]",
          "privateDnsZoneArmResourceId": "[resourceId('Microsoft.Network/privateDnsZones', parameters('postgresPrivateDnsZoneName'))]",
          "publicNetworkAccess": "Disabled"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', parameters('postgresPrivateDnsZoneName'), format('{0}-link', parameters('virtualNetworkName')))]",
        "[resourceId('Microsoft.Network/privateDnsZones', parameters('postgresPrivateDnsZoneName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2024-08-01",
      "name": "[format('{0}/{1}', parameters('postgresServerName'), parameters('postgresDatabaseName'))]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}-private-endpoint', parameters('runtimeVaultName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), 'private-endpoints')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-connection', parameters('runtimeVaultName'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName'))]",
              "groupIds": [
                "vault"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', format('{0}-private-endpoint', parameters('runtimeVaultName')), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "key-vault",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('keyVaultPrivateDnsZoneName'))]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('keyVaultPrivateDnsZoneName'))]",
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-private-endpoint', parameters('runtimeVaultName')))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}-private-endpoint', parameters('clientVaultName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), 'private-endpoints')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-connection', parameters('clientVaultName'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.KeyVault/vaults', parameters('clientVaultName'))]",
              "groupIds": [
                "vault"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('clientVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', format('{0}-private-endpoint', parameters('clientVaultName')), 'default')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "key-vault",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('keyVaultPrivateDnsZoneName'))]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-private-endpoint', parameters('clientVaultName')))]",
        "[resourceId('Microsoft.Network/privateDnsZones', variables('keyVaultPrivateDnsZoneName'))]"
      ]
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "eve-control",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "eve-executor",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-control'), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-control'), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-control')]",
        "[resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-executor'), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-executor'), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-executor')]",
        "[resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('clientVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('clientVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-executor'), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-executor'), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('clientVaultName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-executor')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-07-01",
      "name": "[parameters('containerAppsEnvironmentName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "publicNetworkAccess": "Disabled",
        "vnetConfiguration": {
          "infrastructureSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), 'container-apps-infrastructure')]",
          "internal": true
        },
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
      ]
    }
  ],
  "outputs": {
    "registryLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName')), '2023-07-01').loginServer]"
    },
    "runtimeVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('runtimeVaultName')), '2023-07-01').vaultUri]"
    },
    "clientSecretsVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('clientVaultName')), '2023-07-01').vaultUri]"
    },
    "controlIdentityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-control')]"
    },
    "executorIdentityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'eve-executor')]"
    },
    "containerAppsEnvironmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]"
    },
    "virtualNetworkId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', parameters('virtualNetworkName'))]"
    },
    "containerAppsSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), 'container-apps-infrastructure')]"
    },
    "privateEndpointsSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('virtualNetworkName'), 'private-endpoints')]"
    },
    "postgresServerId": {
      "type": "string",
      "value": "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName'))]"
    },
    "postgresFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresServerName')), '2024-08-01').fullyQualifiedDomainName]"
    },
    "postgresDatabaseName": {
      "type": "string",
      "value": "[parameters('postgresDatabaseName')]"
    },
    "postgresPrivateDnsZoneId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/privateDnsZones', parameters('postgresPrivateDnsZoneName'))]"
    }
  }
}